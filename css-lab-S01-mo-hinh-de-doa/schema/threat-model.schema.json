{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mô hình đe dọa, lab S1",
  "type": "object",
  "required": ["he_thong", "thanh_phan", "moi_de_doa", "chon_xu_ly"],
  "properties": {
    "he_thong": { "type": "string", "minLength": 5 },
    "thanh_phan": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "object", "required": ["ten", "vai_tro"],
        "properties": { "ten": {"type": "string", "minLength": 2},
                        "vai_tro": {"type": "string", "minLength": 5} } }
    },
    "moi_de_doa": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object",
        "required": ["ma", "phat_bieu", "nguyen_ly", "attack", "tac_dong", "kha_nang"],
        "properties": {
          "ma": { "type": "string", "pattern": "^M[0-9]{2}$" },
          "phat_bieu": { "type": "string", "minLength": 40 },
          "nguyen_ly": { "type": "integer", "minimum": 1, "maximum": 7 },
          "attack": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "tac_dong": { "type": "integer", "minimum": 1, "maximum": 5 },
          "kha_nang": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "chon_xu_ly": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["ma", "chi_phi", "don_vi", "can_cu"],
        "properties": {
          "ma": { "type": "string", "pattern": "^M[0-9]{2}$" },
          "chi_phi": { "type": "number", "minimum": 0 },
          "don_vi": { "type": "string", "minLength": 2 },
          "can_cu": { "type": "string", "minLength": 15 }
        }
      }
    }
  }
}
